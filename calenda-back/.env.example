# Runtime
NODE_ENV=production
PORT=3000

# Database (PostgreSQL in production)
DB_TYPE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=change_me
DB_NAME=calenda
DB_SCHEMA=public
DB_SYNCHRONIZE=false

# SQLite fallback (dev only)
SQLITE_PATH=calenda.sqlite

# Auth
JWT_SECRET=change_me_to_a_long_random_secret

# Captcha
CAPTCHA_MODE=dev

# Optional bootstrap / seed
BOOTSTRAP_ADMIN_EMAIL=
SEED_ADMIN=false
SEED_ADMIN_EMAIL=admin@calenda.local
SEED_ADMIN_PSEUDO=admin
SEED_ADMIN_PASSWORD=Admin123!
SEED_ORGANISATEUR=false
SEED_ORGANISATEUR_EMAIL=orga@calenda.local
SEED_ORGANISATEUR_PSEUDO=organisateur
SEED_ORGANISATEUR_PASSWORD=Orga123!
SEED_EVENTS=false
SEED_NEWS=false
